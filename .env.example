XAI_API_KEY=xai-...
XAI_BASE_URL=https://api.x.ai/v1
CHAT_MODEL=grok-3-fast-latest
EMBED_MODEL=grok-embedding-small
CHROMA_PATH=data/chroma
TOP_K=5
MAX_OUTPUT_TOKENS=512
MAX_CONTEXT_CHARS=6000
EMBED_BATCH_SIZE=32
INGEST_ON_STARTUP=false
RAG_OFFLINE=0
# When RAG_OFFLINE=1: retrieve (real excerpts, no xAI) or mock (fixed test string)
RAG_OFFLINE_MODE=retrieve
# Rebuild index from data/raw on startup when offline and index is missing/stale
RAG_AUTO_SEED_OFFLINE=true